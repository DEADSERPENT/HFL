{
  "name": "pp-hfm-observatory",
  "version": "1.0.0",
  "private": true,
  "description": "PP-HFM Research Observatory: a curated, static, public research website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-public-bundle.mjs",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  }
}
